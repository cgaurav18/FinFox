<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview (Android 12+): what the Scan & Pay widget looks like. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:gravity="center"
    android:orientation="vertical" android:padding="8dp">
    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_shortcut_scan" android:contentDescription="@null" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:text="@string/shortcut_scan_short" android:textColor="#1B2623" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
