<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the FinFox icon (or drag these to the home screen). Each opens a screen through the "route" extra. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="scan_pay" android:enabled="true" android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan_short" android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.mymoney.app" android:targetClass="com.mymoney.app.MainActivity">
            <extra android:name="route" android:value="pay?scan=true" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="receive" android:enabled="true" android:icon="@drawable/ic_shortcut_receive"
        android:shortcutShortLabel="@string/shortcut_receive_short" android:shortcutLongLabel="@string/shortcut_receive_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.mymoney.app" android:targetClass="com.mymoney.app.MainActivity">
            <extra android:name="route" android:value="receive" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="add_expense" android:enabled="true" android:icon="@drawable/ic_shortcut_expense"
        android:shortcutShortLabel="@string/shortcut_expense_short" android:shortcutLongLabel="@string/shortcut_expense_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.mymoney.app" android:targetClass="com.mymoney.app.MainActivity">
            <extra android:name="route" android:value="txn-edit?id=-1&amp;type=EXPENSE" />
        </intent>
    </shortcut>
</shortcuts>
