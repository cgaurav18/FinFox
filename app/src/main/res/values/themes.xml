<resources>
    <style name="Theme.MyMoney" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- System splash (Android 12+ API, back-ported by core-splashscreen): fox on deep plum. -->
    <style name="Theme.MyMoney.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_fox</item>
        <item name="postSplashScreenTheme">@style/Theme.MyMoney</item>
    </style>
</resources>
