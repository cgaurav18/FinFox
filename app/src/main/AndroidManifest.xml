<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network is used only for the optional Google Sign-In and the user's own Google Drive backups.
         Everything else works offline; financial data is stored only in the local Room database. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Auto-capture (optional, asked for only when the user turns it on): bank SMS are parsed on the device
         to record payments. Message text never leaves the phone. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Scan & Pay hands the payment to an installed UPI app (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" android:host="pay" />
        </intent>
    </queries>

    <application
        android:name=".MyMoneyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyMoney.Splash"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyMoney.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Pay with FinFox": listed as a UPI app in shopping apps (Blinkit, Zepto, …). FinFox records the payment
             and forwards the link, unchanged, to the user's own UPI app. Standard launch mode so the result
             reaches the calling app. -->
        <activity
            android:name=".UpiForwardActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyMoney">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Some payment SDKs look up UPI apps with a BROWSABLE intent; without it FinFox wouldn't be listed. -->
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="upi" android:host="pay" />
            </intent-filter>
        </activity>

        <!-- Home screen widgets (Jetpack Glance) -->
        <receiver
            android:name=".widgets.TotalBalanceReceiver"
            android:exported="true"
            android:label="Total Balance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_total_balance" />
        </receiver>

        <receiver
            android:name=".widgets.IncomeExpenseReceiver"
            android:exported="true"
            android:label="Income &amp; Expenses">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_income_expense" />
        </receiver>

        <receiver
            android:name=".widgets.QuickActionsReceiver"
            android:exported="true"
            android:label="Quick Actions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions" />
        </receiver>

        <receiver
            android:name=".widgets.UpcomingPaymentsReceiver"
            android:exported="true"
            android:label="Upcoming Payments">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming" />
        </receiver>

        <receiver
            android:name=".widgets.MoneyWithPeopleReceiver"
            android:exported="true"
            android:label="Money with People">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_people" />
        </receiver>

        <receiver
            android:name=".widgets.BudgetReceiver"
            android:exported="true"
            android:label="Budget Tracker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget" />
        </receiver>

        <receiver
            android:name=".widgets.CreditCardReceiver"
            android:exported="true"
            android:label="Credit Cards">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_credit_cards" />
        </receiver>

        <!-- "Remind later" / "Dismiss" notification buttons. Not exported: only our PendingIntents reach it. -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- Auto-capture: live bank SMS. Only the system (BROADCAST_SMS) can send to it. -->
        <receiver
            android:name=".autocapture.SmsCaptureReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Auto-capture: payment notifications from UPI and bank apps. The user enables it in system settings. -->
        <service
            android:name=".autocapture.PaymentNotificationListener"
            android:exported="true"
            android:label="@string/capture_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WorkManager is initialised by MyMoneyApp (HiltWorkerFactory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
